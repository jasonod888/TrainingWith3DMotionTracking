ENVIRONMENT=development
PORT=8001
DATABASE_URL=postgresql+psycopg://form:form@localhost:5433/form
# Demonstration media is opt-in, local-only by default. Do not publish without rights.
DEMO_ENABLED=true
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=form
STORAGE_ADDRESSING_STYLE=path
STORAGE_ACCESS_KEY=form-local
STORAGE_SECRET_KEY=local-development-only
PUBLIC_URL=http://127.0.0.1:5173
SESSION_DAYS=7
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM=Form <hello@form.local>
MAX_UPLOAD_BYTES=262144000
MAX_CONVERSION_SECONDS=300
MAX_ACTIVE_CONVERSIONS=2
MAX_ACCOUNT_STORAGE_BYTES=2147483648
WORKER_LEASE_SECONDS=120
# Independent of Railway/AWS hosting. Never automatically falls back to a paid provider.
CONVERSION_PROVIDER=local
# Keep false until a full SAM pipeline deployment has passed compatibility checks.
REMOTE_CONVERSION_ENABLED=false
# Remote custom deployment/app in owner/name format; empty for local.
CONVERSION_TARGET=
REMOTE_CONVERSION_CONCURRENCY=1
# Hosted environments: set ENVIRONMENT=production, PUBLIC_URL=https://your-domain,
# SMTP_STARTTLS=true, SMTP_PORT=587, SMTP_USERNAME and SMTP_PASSWORD.
